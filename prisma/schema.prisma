generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection for normal app queries.
  url       = env("DATABASE_URL")
  // Direct connection, used only for `prisma migrate` / `db push` (schema
  // changes need a non-pooled connection).
  directUrl = env("DIRECT_URL")
}

/// Product categories offered for sourcing/export. Populated from verified
/// content only — see assets/CONTENT.md section 2.1.
model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  category          String
  shortDescription  String
  description       String
  origin            String   @default("Indonesia")
  grade             String?
  size              String?
  processing        String?
  moisture          String?
  packaging         String?
  moq               String?
  hsCode            String?
  loadingPort       String?
  availability      String?
  seoTitle          String
  seoDescription    String
  featuredImageAlt  String?
  featured          Boolean  @default(false)
  sortOrder         Int      @default(0)
  relatedArticles   Article[] @relation("ProductArticles")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

/// Blog articles targeting buyers researching Indonesian suppliers.
model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  author          String
  publishDate     DateTime
  category        String
  tags            String[]  @default([])
  coverImageUrl   String?
  seoTitle        String
  seoDescription  String
  published       Boolean   @default(false)
  relatedProducts Product[] @relation("ProductArticles")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishDate])
}

/// Admin-managed list of category labels offered in the Article editor's
/// category dropdown. Article.category stays a plain string (not a
/// relation) — deleting or renaming a category here never touches
/// already-published articles, it only changes what's offered going
/// forward.
model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum InquiryStatus {
  NEW
  REVIEWED
  ARCHIVED
}

/// Submissions from the Request a Quote page (primary site conversion).
model QuoteRequest {
  id                  String        @id @default(cuid())
  name                String
  company             String?
  email               String
  phone               String?
  destinationCountry  String
  /// Container-based volume estimate (e.g. "1 x 20' FCL") — free text so the
  /// dropdown's option labels can change without a migration.
  quantityEstimate    String?
  /// Free-text buyer inquiry — product type, grade, packing, Incoterm,
  /// loading port, etc. Replaces the earlier set of separate granular fields.
  inquiryDetails      String
  locale              String        @default("en")
  status              InquiryStatus @default(NEW)
  createdAt           DateTime      @default(now())

  @@index([status, createdAt])
}

/// Submissions from the general Contact page.
model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  country    String?
  subject    String?
  message    String
  locale     String        @default("en")
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

/// Newsletter / mailing-list signups (footer + homepage forms).
model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  locale     String   @default("en")
  createdAt  DateTime @default(now())
}

/// Admin panel login. Single account for now (see src/lib/auth.ts) — the
/// model allows more without a migration if that ever changes.
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
}

/// Opaque server-side session record. The cookie only ever holds the raw
/// token; `tokenHash` (its SHA-256) is what's stored here, so a stolen DB
/// dump doesn't hand over usable session tokens.
model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Singleton (always id=1, upsert-only) — replaces the hardcoded COMPANY /
/// SOCIAL_LINKS constants in src/lib/constants.ts. Read via
/// getSiteSettings() in src/lib/data.ts, which falls back to those same
/// hardcoded values until this row exists.
model SiteSettings {
  id            Int      @id @default(1)
  phone         String
  whatsapp      String
  email         String
  address       String
  shortAddress  String
  businessHours String
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  logoUrl       String?
  faviconUrl    String?

  /// SMTP settings for the "new submission" emails sent from the Request a
  /// Quote / Contact forms (see src/lib/email.ts). All optional — sending
  /// is skipped (form submissions still save fine) until every field
  /// except smtpSecure is set. smtpPassword is never sent back to the
  /// browser by the settings API; leaving that field blank on save keeps
  /// whatever is already stored.
  smtpHost      String?
  smtpPort      Int?
  smtpSecure    Boolean  @default(false)
  smtpUser      String?
  smtpPassword  String?
  smtpFromName  String?
  smtpFromEmail String?
  notifyToEmail String?

  updatedAt     DateTime @updatedAt
}

/// Buyer testimonials shown on Home/About. English-only, admin-managed —
/// replaces the placeholder copy that used to live in home.testimonials.items
/// across the i18n message files (same "DB content, not translated" model
/// already used for Article/Product).
model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  role      String
  country   String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// "Our People" on the About page — admin-managed, photo optional (falls
/// back to a generic avatar badge, same pattern GalleryItem uses for its
/// optional imageUrl).
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photoUrl  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

/// A real uploaded photo or video. altText is derived automatically from
/// the original filename at upload time (see deriveAltText() in
/// src/lib/gallery-media.ts) — there is no title/caption/icon by design.
model GalleryItem {
  id        String           @id @default(cuid())
  mediaType GalleryMediaType
  url       String
  altText   String
  sortOrder Int              @default(0)
  published Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([published, sortOrder])
}

/// Per-page SEO overrides for static routes that have no DB row of their
/// own (Home, About, Gallery, Contact, Blog index). Article/Product already
/// carry seoTitle/seoDescription columns directly and don't need this.
model PageSeo {
  id             String   @id @default(cuid())
  path           String   @unique
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}
