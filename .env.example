# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection strings.
# Local (matches docker-compose.yml): both vars can be identical.
#   DATABASE_URL="postgresql://pakindo:pakindo_dev_password@localhost:5432/pakindo_impex?schema=public"
#   DIRECT_URL="postgresql://pakindo:pakindo_dev_password@localhost:5432/pakindo_impex?schema=public"
# Neon (or another pooled provider): DATABASE_URL is the pooled connection
# (used by the app at runtime), DIRECT_URL is the non-pooled connection
# (used only for `prisma migrate` / `db push`, which need a direct connection).
DATABASE_URL="postgresql://pakindo:pakindo_dev_password@localhost:5432/pakindo_impex?schema=public"
DIRECT_URL="postgresql://pakindo:pakindo_dev_password@localhost:5432/pakindo_impex?schema=public"

# --- Email notifications (Request a Quote / Contact forms) ---
# TODO: Not yet active. Create a Resend account (https://resend.com), verify
# a sending domain, and set these to enable email notifications. Until
# RESEND_API_KEY is set, submissions are stored in the database only — see
# src/lib/email.ts.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="Pakindo Impex Website <notifications@pakindoimpex.com>"
# TODO: [VERIFY: EMAIL ADDRESS] — internal inbox that should receive new
# quote requests and contact messages.
NOTIFICATIONS_TO_EMAIL=""

# Public site URL, used for canonical/OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Translation script (scripts/translate-messages.ts) ---
# Only needed to run `npm run translate`. Get a FREE key (no credit card, no
# billing setup — just a Google account) at https://aistudio.google.com/apikey.
# Not read by the site itself at runtime — this is a local dev-tooling script
# only, so the person hosting the site never needs this key.
GEMINI_API_KEY=""
